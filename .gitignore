# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# isolated output for `npm run build:check` — see scripts/build-check.mjs
/.next-verify/
/out/

# serwist / PWA service worker (generated at build)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# MCP config — contains a Supabase access token (secret); never commit
.mcp.json

# Claude Code local tooling, skills, plans & machine-specific settings
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local dev-server log capture
.devlog.txt

# Vocabulary miner (scripts/mine-name-vocabularies.mts) — both regenerated on
# demand. The 668 KB HSN workbook is a cached download, and the proposal file is
# a working document: what gets KEPT from it lands in name-vocabularies.ts, which
# is committed. Committing the proposals instead would turn a reviewed decision
# back into a list of maybes.
/scripts/.vocab-cache/
/scripts/out/

# Python bytecode from scripts/audit_layout.py — regenerated on every run
__pycache__/
*.py[cod]

# MSYS/Git-Bash crash dumps, written into the repo root where the shell was
*.stackdump
