+        // PATCHED (raagam) -- the class-substring list ("modal", "overlay",
+        // "dialog", "popover", ...) and the role list ("dialog", "alertdialog",
+        // "tooltip", "menu") were REMOVED.
+        //
+        // In this ERP the dialog IS the screen. Sheet, DataPicker, the import
+        // dialog and the search palette all carry role="dialog", so a capture
+        // taken while an editor was open rendered the LIST PAGE UNDERNEATH it --
+        // the "it screenshots another screen" the client reported. Those roles
+        // cannot be dropped app-side: lib/reload-guard.ts finds modals by them,
+        // keyboard-nav-provider.tsx resolves focus scope by them, and they are
+        // the accessibility contract.
+        //
+        // A capture tool must not GUESS that an overlay is chrome. Anything that
+        // genuinely must not appear opts out explicitly with the attribute the
+        // next branch already honours: data-html2canvas-ignore.
         if (element.hasAttribute("data-radix-portal") || element.hasAttribute("data-sonner-toaster") || element.hasAttribute("data-html2canvas-ignore")) {
           return true;
         }
