{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "webworker"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-fold/types/**/*.ts",
    ".next-fold/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-build2/types/**/*.ts",
    ".next-build2/dev/types/**/*.ts",
    ".next-shot/types/**/*.ts",
    ".next-shot/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/check-amendment-diff.mts",
    "scripts/check-order-value.mts",
    "scripts/check-bom-requirement.mts",
    "scripts/check-pack-composition.mts",
    "scripts/check-uom-prefill.mts",
    "scripts/check-pack-type-explosion.mts",
    "scripts/check-process-return.mts",
    "scripts/check-fabric-bom.mts",
    "scripts/check-fabric-plan.mts",
    "scripts/check-yarn-process.mts",
    "scripts/check-fabric-components.mts",
    "scripts/check-budget-totals.mts",
    "scripts/check-gstin.mts",
    "scripts/check-name-suggest.mts",
    "scripts/check-keyboard-holds.mts",
    "scripts/check-module-groups.mts",
    "scripts/check-po-no.mts",
    "scripts/check-rejection-ladder.mts",
    "scripts/check-style-rules.mts",
    "scripts/check-price-modes.mts",
    "scripts/check-picker-identity.mts",
    "scripts/check-size-order.mts",
    "scripts/check-composition-match.mts",
    "scripts/check-process-loss.mts",
    "scripts/check-combo-anchor.mts",
    "scripts/check-colour-by-type.mts",
    "scripts/check-assort-weights.mts",
    "scripts/check-bom-slices.mts",
    "scripts/check-ta-schedule.mts",
    "scripts/check-ta-ladder.mts",
    "scripts/check-ta-merge.mts",
    "scripts/check-amendment-files.mts",
    "scripts/check-customer-dedup.mts",
    "scripts/check-qty-balance.mts",
    "scripts/check-requirement-sheet.mts",
    "scripts/check-approval-tree.mts",
    "scripts/check-assort-style.mts",
    "scripts/mine-name-vocabularies.mts",
    "scripts/vocab-sources/**/*.mts"
  ]
}
